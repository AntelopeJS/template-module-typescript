{
  "name": "antelopejs-module",
  "version": "0.0.1",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./dist/*": "./dist/*/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && tsc --skipLibCheck",
    "dev": "ajs project run -w -p playground",
    "test": "ajs module test",
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" != \"$(pwd -P)\" ] || if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1; then lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "sync": "antelopejs-sync --profile template",
    "sync:check": "antelopejs-sync --check --profile template",
    "typecheck": "tsc --noEmit --tsBuildInfoFile node_modules/.cache/typecheck/.tsbuildinfo",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update",
    "checks:prepare": "pnpm build"
  },
  "dependencies": {
    "@antelopejs/interface-core": ">=0.5.1 <0.6.0"
  },
  "devDependencies": {
    "@antelopejs/core": "~1.24.5",
    "@antelopejs/tooling-configs": ">=0.8.4 <0.9.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "knip": "^6.46.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.77.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2007",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.6.5",
  "pnpm": {
    "onlyBuiltDependencies": []
  },
  "antelopeJs": {
    "baseUrl": "dist",
    "implements": [
      "antelopejs-module"
    ],
    "paths": {
      "@/*": [
        "*"
      ]
    },
    "test": "antelope.test.ts"
  }
}
