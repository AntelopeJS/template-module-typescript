{
  "name": "antelopejs-module",
  "version": "0.0.1",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./dist/*": "./dist/*/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ajs project run -w -p playground",
    "test": "ajs module test",
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" != \"$(pwd -P)\" ] || if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1; then lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "ratchet": "antelopejs-ratchet",
    "sync": "antelopejs-sync --profile template",
    "ratchet:update": "antelopejs-ratchet --update",
    "sync:check": "antelopejs-sync --check --profile template",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip"
  },
  "dependencies": {
    "@antelopejs/interface-core": ">=0.1.1 <1.0.0"
  },
  "devDependencies": {
    "@antelopejs/core": "^1.13.3",
    "@antelopejs/tooling-configs": "^0.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.6.5",
  "antelopeJs": {
    "baseUrl": "dist",
    "implements": [
      "antelopejs-module"
    ],
    "paths": {
      "@/*": [
        "*"
      ]
    },
    "test": "antelope.test.ts"
  }
}
