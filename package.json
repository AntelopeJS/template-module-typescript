{
  "name": "antelopejs-module",
  "version": "0.0.1",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./dist/*": "./dist/*/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ajs project run -w -p playground"
  },
  "dependencies": {
    "@antelopejs/interface-core": ">=0.1.1 <1.0.0"
  },
  "antelopeJs": {
    "baseUrl": "dist",
    "implements": [
      "antelopejs-module"
    ],
    "paths": {
      "@/*": [
        "*"
      ]
    }
  },
  "devDependencies": {
    "@antelopejs/core": "^1.9.1",
    "@types/node": "^22.19.15",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.6.5"
}
